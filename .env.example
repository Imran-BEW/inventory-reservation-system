# PostgreSQL connection string from Supabase / Neon / Railway
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgresql://..."

# Your deployed URL (used for server-side fetches in SSR)
NEXT_PUBLIC_BASE_URL="https://your-app.vercel.app"

# Upstash Redis (optional — for idempotency via Redis instead of Postgres)
UPSTASH_REDIS_REST_URL="https://..."
UPSTASH_REDIS_REST_TOKEN="..."

# Vercel Cron secret (set in Vercel dashboard, prevents unauthorized cron triggers)
CRON_SECRET="a-long-random-string"
